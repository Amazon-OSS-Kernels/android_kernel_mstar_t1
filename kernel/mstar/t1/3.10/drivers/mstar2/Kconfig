#===================================================
# MStar Board Selection
#===================================================
choice
    prompt "MStar Board Selection"
    default None

config BOARD_MSTAR_NONE
    bool "None"

config BOARD_MSTAR_MST110B
    bool "BOARD_MSTAR_MST110B"
    help
        select PCB to MST110B.

config BOARD_MSTAR_MST107B
    bool "BOARD_MSTAR_MST107B"
    help
        select PCB to MST107B.

config BOARD_AMAZON_TF_abc123
    bool "BOARD_AMAZON_TF_abc123"
    help
        select PCB to TF_abc123.

config BOARD_AMAZON_COMPAL_ALISON
    bool "BOARD_AMAZON_COMPAL_ALISON"
    help
        select PCB to COMPAL_ALISONO.
endchoice

#===================================================
# MStar Chip (auto-select)
# 0: None
# 1: Titania
# 2: Triton
# 3: Titania2
#===================================================
config MSTAR_CHIP_TYPE
	int
	default 1 if MSTAR_TITANIA
	default 2 if MSTAR_TRITON
	default 3 if MSTAR_TITANIA2
	default 4 if MSTAR_OBERON
	default 5 if MSTAR_EUCLID
	default 0

#===================================================
# MStar Chip Name (auto-select)
#===================================================
config MSTAR_CHIP_NAME
	string
	default "einstein" if MSTAR_EINSTEIN
	default "napoli" if MSTAR_NAPOLI
	default "madison" if MSTAR_MADISON
	default "messi" if MSTAR_MESSI
	default "miami" if MSTAR_MIAMI
	default "clippers" if MSTAR_CLIPPERS
	default "monaco" if MSTAR_MONACO
	default "maldives" if MSTAR_MALDIVES
	default "kaiser" if MSTAR_KAISER
	default "muji" if MSTAR_MUJI
	default "muji" if MSTAR_MUJI_32
	default "kano" if MSTAR_KANO
	default "kano" if MSTAR_KANO_32
	default "monet" if MSTAR_MONET
	default "monet" if MSTAR_MONET_32
	default "manhattan" if MSTAR_MANHATTAN
	default "maserati" if MSTAR_MASERATI
	default "maserati" if MSTAR_MASERATI_32
	default "maxim" if MSTAR_MAXIM
	default "maxim" if MSTAR_MAXIM_32
	default "kris" if MSTAR_KRIS
	default "error"

#===================================================
# Titania 2 Chip Revision Selection
#===================================================
if MSTAR_TITANIA2
choice
	prompt "-- Titania 2 Chip Revision"
	default None

config MSTAR_TITANIA2_REV_NONE
	bool "None"

config MSTAR_TITANIA2_REV_U02
    bool "U02"

config MSTAR_TITANIA2_REV_U03
    bool "U03"

endchoice
endif

#===================================================
#Chip based define
#===================================================
config MSTAR_ARM
    bool "Enable ARM BASE CPU"
    default n
    select TEE
config MSTAR_MIPS
    bool "Enable MIPS BASE CPU"
	depends on !MSTAR_ARM
    default n


#===================================================
#Android recovery Flag
#===================================================

config WRITE_TO_ANDROID_MISC
    bool "Write Andorid recovery command to partition"
    default n

choice
  depends on WRITE_TO_ANDROID_MISC
	prompt "storage type"
	default EMMC

config WRITE_TO_ANDROID_MISC_EMMC
    bool "EMMC"

config WRITE_TO_ANDROID_MISC_NAND
    bool "NAND"
endchoice

config MP_EMMC_TRIM
    bool "Enable EMMC TRIM/SEC TRIM"
    default y

config MP_EMMC_CACHE
    bool "Enable MMC_CAP2_CACHE_CTRL capability which is introduced in by eMMC 4.5 spec"
    default y

config LX3_SUPPORT
    bool "LX3 support"
    default n

#===================================================
# USB MIU1 PATCH
#===================================================
config MS_USB_MIU1_PATCH
    bool
    default n

#===================================================
# USB NAND PATCH
#===================================================
config MS_NAND_MIU1_PATCH
    bool
    default n

config MSTAR_COOCAA_AUTH
    bool "Link with COOCAA Authorization"
    default n

